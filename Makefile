NAME := libasm.a

# sources ---------------------------------------------------------------------#

DIR_SRC		:=	src

SRC_ASM		:= ft_strlen.s

SRC_C		:= main.c

# objects ---------------------------------------------------------------------#

OBJ_DIR		:=	.build
OBJ_ASM		:= $(SRC_ASM:$(DIR_SRC)/%.s=$(OBJ_DIR)/%.o)


# compilation -----------------------------------------------------------------#

NASM		:= nasm
NASM_FLAGS 	:= -m elf_x86_64

CC				:=	cc
CC_FLAGS		:=	-Wall -Wextra -Werror

#------------------------------------------------------------------------------#
# rules                                                                        #
#------------------------------------------------------------------------------#

all: init
	@$(MAKE) -j makeall
	@echo -e "\t$(BLINK_GREEN)$(NAME) = COMPILATION FINISHED !$(NC)"

clean:
	@rm -rf $(DIR_BUILD) && printf "Cleaning : $(OBJ_DIR)\n"


fclean: clean
	@rm -f $(NAME)

re: fclean
	@$(MAKE) -j makeall


init:
	@echo -e ""
	@echo -e "\t\t$(BHYEL)┍━━━━━━━━»•» 🌸 «•«━┑$(NC)"
	@echo -e "\t\t$(BHYEL)  libasm COMPILATION $(NC)"
	@echo -e "\t\t$(BHYEL)┕━»•» 🌸 «•«━━━━━━━━┙$(NC)"
	@echo -e ""

#------------------------------------------------------------------------------#
# compilation                                                                  #
#------------------------------------------------------------------------------#

$(DIR_BUILD)/%.o: $(DIR_SRC)/%.c
	@mkdir -p $(@D)
	@printf "\033[2K\rcompiling: %s" $@
	@$(CC) $(CC_FLAGS) $(I_FLAG) -c $< -o $@

#------------------------------------------------------------------------------#
# linkage                                                                      #
#------------------------------------------------------------------------------#

$(NAME): $(OBJ_ASM)
	@$(MAKE) -j -C libft
	@$(CC) $(CC_FLAGS) $(OBJ_MAND) $(L_FLAG) $(l_FLAG) -o $(NAME)
	@printf "\033[2K\rcreated: %s\n" $@

#------------------------------------------------------------------------------#
# specifications                                                               #
#------------------------------------------------------------------------------#

.PHONY: all \
		clean \
		fclean \
		bonus \
		re
